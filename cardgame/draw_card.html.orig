var resultCard10 = document.getElementById('resultCard10');
var resultActions = document.getElementById('resultActions');
resultCard.classList.remove('show');
resultCard10.classList.remove('show');
resultActions.classList.add('hidden');
cardBack.style.display = 'flex';
cardBack.classList.add('drawing');
setTimeout(async function() {
var cards = [];
for (var i = 0; i < 10; i++) {
cards.push(doDraw());
}
cardBack.classList.remove('drawing');
cardBack.style.display = 'none';
await showResult10(cards);
updateAlbumProgress(allCharacters);
renderAlbum();
var cost10 = Math.floor(drawCost * 10 * 0.9);
resultActions.innerHTML = '<button class="draw-btn draw-btn-10" onclick="drawCard10()">鍐嶆潵鍗佽繛</button><button class="draw-btn" onclick="resetDraw()">杩斿洖</button></p><p class="cost-text">鍗佽繛娑堣€?<span id="drawCost10">'+cost10+'</span> <span id="currencyUnit">'+currencyName+'</span> (9鎶?</p><p id="userBalance" class="balance-text" style="color:#ffd700;font-size:16px;font-weight:bold;margin-top:10px;">鎴戠殑' + currencyName + ': ' + myGold + '</p>';
resultActions.classList.remove('hidden');
isDrawing = false;
// 鏇存柊浣欓鏄剧ず
var balanceEl = document.getElementById('userBalance');
if (balanceEl) balanceEl.textContent = '鎴戠殑' + currencyName + ': ' + myGold;
}, 2000);
}

function doDraw() {
    var config = drawConfig;
    var rarityWeights = config.rarity_weight || [];
    var selectedTags = config.tag || [];
    var tagWeightMap = {};
    (config.tag_weight || []).forEach(function(tw) {
        var key = Object.keys(tw)[0];
        var val = tw[key];
        tagWeightMap[key] = val;
    });
    
    var allCards = gameData.characters || [];
    
    // 1. Tag 杩囨护
    var filteredCards = allCards.filter(function(card) {
        var cardTags = card.tags || [];
        return selectedTags.length === 0 || cardTags.some(function(t) { return selectedTags.includes(t); });
    });
    
    // 鍔ㄦ€佷粠閰嶇疆璇诲彇绋€鏈夊害鏁伴噺锛堜娇鐢ㄦ潈閲嶆暟缁勯暱搴︿綔涓虹湡瀹炴潵婧愶級
    var rarityCount = Math.max(rarityWeights.length || 1, rarityConfig.length || 1);
    var totalRarityWeight = rarityWeights.reduce(function(a, b) { return a + b; }, 0);
    
    // 3. 纭畾绋€鏈夊害
    var rand = Math.random() * totalRarityWeight;
    var selectedRarity = 1;
    var accumulated = 0;
    for (var r = 1; r <= rarityCount; r++) {
        accumulated += rarityWeights[r - 1] || 0;
        if (rand < accumulated) {
            selectedRarity = r;
            break;
        }
        selectedRarity = r;
    }
    
    // 5. 璇ョ█鏈夊害鍐呯殑鍗＄墝锛岃绠楁潈閲?    var rarityCards = filteredCards.filter(function(c) { return c.rarity === selectedRarity; });
    var totalWeight = 0;
    var cardWeights = [];
    
    rarityCards.forEach(function(card) {
        var baseWeight = card.draw_weight || 100;
        var tagAdjustment = 0;
        (card.tags || []).forEach(function(t) {
            if (tagWeightMap[t] !== undefined) {
                tagAdjustment += tagWeightMap[t];
            }
        });
        var finalWeight = Math.max(0, baseWeight + tagAdjustment);
        cardWeights.push({ card: card, weight: finalWeight });
        totalWeight += finalWeight;
    });
    
    // 6. 鏍规嵁鏉冮噸鎶藉彇
    if (totalWeight === 0 || rarityCards.length === 0) {
        // 濡傛灉娌℃湁鏈夋晥鍗★紝闅忔満杩斿洖涓€涓?        return filteredCards[Math.floor(Math.random() * filteredCards.length)] || allCards[0];
    }
    
    var drawRand = Math.random() * totalWeight;
    var accumulatedWeight = 0;
    for (var i = 0; i < cardWeights.length; i++) {
        accumulatedWeight += cardWeights[i].weight;
        if (drawRand <= accumulatedWeight) {
            return cardWeights[i].card;
        }
    }
    
    return cardWeights[cardWeights.length - 1].card;
}

async function showResult(card) {
var rarityColor = getRarityColor(card.rarity);
var cost = gameData.settings.drawCost || 100;
var stats = card.baseStats || {};

var isNew = !ownedCardIds[card.id];
console.log('showResult card:', card, 'baseStats:', card.baseStats); // 鐢ㄦ暟鎹簱鏌ヨ鐨勭粨鏋滃垽鏂槸鍚︽柊鍗?
// 淇濆瓨鍒版暟鎹簱锛圓PI浼氳繑鍥炴槸鍚︽柊鍗★級
var rc = document.getElementById('resultCard');
console.log('淇濆瓨鍗＄墝: userId=' + userId + ', card_id=' + card.id + ', config_id=' + currentConfigId);
await fetch('game_api.php?action=add_user_card&user_id=' + userId + '&card_id=' + card.id + '&config_id=' + currentConfigId + '&draw_count=1', {method: 'POST'})
    .then(r => r.text())
    .then(t => {
        try { JSON.parse(t); } catch(e) {}
        if (!myCards[card.id]) myCards[card.id] = JSON.parse(JSON.stringify(card));
        myCards[card.id].count = (myCards[card.id].count || 0) + 1;
        renderMyCards();
    });

var newTag = isNew ? '<span class="new-tag">鏂帮紒</span>' : '';
var rarityColor = getRarityColor(card.rarity);
var names = getRarityNames(card.rarity);
rc.innerHTML = '<div class="result-image"><img src="'+getImageUrl(card)+'" alt="'+card.name+'"></div><div class="result-info"><h2 class="rarity-'+card.rarity+'" style="color:'+rarityColor+'">'+card.name+newTag+'</h2><div class="result-rarity" style="color:'+rarityColor+'">'+'猸?.repeat(card.rarity)+' '+getRarityName(card.rarity)+'</div><p class="result-desc">'+(card.description||'')+'</p></div>';
document.getElementById('resultActions').innerHTML = '<button class="draw-btn" onclick="drawCard()">鍐嶆娊涓€寮?/button><button class="draw-btn" onclick="resetDraw()">杩斿洖</button><p class="cost-text">娑堣€?'+cost+' '+currencyName+'</p><p id="userBalance" class="balance-text" style="color:#ffd700;font-size:16px;font-weight:bold;margin-top:10px;">鎴戠殑' + currencyName + ': ' + myGold + '</p>';
resultActions.classList.remove('hidden');
rc.classList.add('show');
renderMyCards();
}

function renderMyCards() {
var container = document.getElementById('myCards');
if (!container) return;
var cards = Object.values(myCards);

// Apply filter
cards = cards.filter(function(card) {
    if (filterState.name && !card.name.toLowerCase().includes(filterState.name)) return false;
    if (filterState.rarity && card.rarity !== parseInt(filterState.rarity)) return false;
    return true;
});

// Sort by rarity (descending)
cards.sort(function(a, b) { return b.rarity - a.rarity; });

if (cards.length === 0) { container.innerHTML = '<div class="empty">杩樻病鏈夊崱鐗岋紝蹇幓鎶藉崱鍚э紒</div>'; return; }
var html = '';
cards.forEach(function(card) {
html += '<div class="my-card" onclick="showCardPopup('+card.id+')"><div class="card-thumb"><img src="'+getImageUrl(card)+'" alt="'+card.name+'"></div><h4 class="rarity-'+card.rarity+'">'+card.name+'</h4><span class="count">x'+card.count+'</span></div>';
});
container.innerHTML = html;
}

function getStatColor(value, statName) {
var max = maxStats[statName];
var min = minStats[statName];
var range = max - min;
if (range === 0) return '#aaa';
var percent = (value - min) / range * 100;
if (percent >= 100) return '#ff0000';
if (percent >= 80) return '#ffd700';
if (percent >= 60) return '#9400d3';
if (percent >= 40) return '#4169e1';
if (percent >= 20) return '#00ff00';
return '#ffffff';
}

// 鑾峰彇绋€鏈夊害鍚嶇О - 浼樺厛浠?rarityConfig 鍔ㄦ€佽鍙栵紝鍚﹀垯浣跨敤 fallback
function getRarityName(rarity) {
    // 浼樺厛浠庡姩鎬侀厤缃幏鍙?    if (rarityConfig && rarityConfig.length > 0) {
        var config = rarityConfig.find(function(c) { return c.rarity === rarity; });
        if (config) return config.name;
    }
    // Fallback: 鏋勫缓鍔ㄦ€?fallback 鏁扮粍锛堟敮鎸佷换鎰忕█鏈夊害鏁伴噺锛?    var fallbackNames = ['', '鏅€?, '绋€鏈?, '鏉板嚭', '鍙茶瘲', '浼犺', '杩滃彜'];
    // 鍔ㄦ€佹墿灞?fallback 鏁扮粍浠ユ敮鎸佹洿澶氱█鏈夊害
    var extendedFallnames = ['', '鏅€?, '绋€鏈?, '鏉板嚭', '鍙茶瘲', '浼犺', '杩滃彜', '绁炶瘽', '鑷冲皧', '鐜嬭€?, '澶╀娇', '鎭堕瓟'];
    if (rarity >= 1 && rarity < extendedFallnames.length) {
        return extendedFallnames[rarity];
    }
    return '绋€鏈夊害' + rarity;
}

// 鑾峰彇绋€鏈夊害棰滆壊 - 浼樺厛浠?rarityConfig 鍔ㄦ€佽鍙栵紝鍚﹀垯浣跨敤 fallback
function getRarityColor(rarity) {
    // 浼樺厛浠庡姩鎬侀厤缃幏鍙?    if (rarityConfig && rarityConfig.length > 0) {
        var config = rarityConfig.find(function(c) { return c.rarity === rarity; });
        if (config) return config.color;
    }
    // Fallback: 鍔ㄦ€侀鑹叉暟缁?    var fallbackColors = ['', '#ffffff', '#4caf50', '#2196f3', '#9c27b0', '#ff9800', '#f32b2b', '#00ffff', '#ff00ff', '#ffa500', '#fffacd', '#ff6347'];
    if (rarity >= 1 && rarity < fallbackColors.length) {
        return fallbackColors[rarity];
    }
    return '#fff';
}

// 鑾峰彇绋€鏈夊害鍚嶇О
function getRarityNames(rarity) {
    if (typeof getRarityNamesFromConfig === 'function') {
        var names = getRarityNamesFromConfig();
        return names[rarity] || '鏈煡';
    }
    var fallback = ['', '鏅€?, '绋€鏈?, '鏉板嚭', '鍙茶瘲', '浼犺', '杩滃彜'];
    return fallback[rarity] || '鏈煡';
}

// 鍔ㄦ€佸～鍏呯█鏈夊害绛涢€変笅鎷夋
function populateRarityFilter() {
    var select = document.getElementById('filterRarity');
    if (!select || !rarityConfig || rarityConfig.length === 0) return;
    
    // 淇濈暀"鍏ㄩ儴绋€鏈夊害"閫夐」
    select.innerHTML = '<option value="">鍏ㄩ儴绋€鏈夊害</option>';
    
    // 鍔ㄦ€佹坊鍔犵█鏈夊害閫夐」
    rarityConfig.forEach(function(cfg) {
        var option = document.createElement('option');
        option.value = cfg.rarity;
        var starStr = '猸?.repeat(cfg.rarity);
        option.textContent = starStr + ' ' + cfg.name;
        select.appendChild(option);
    });
}

// 鍏ㄥ眬娣″寲棰滆壊鍑芥暟
function lightenColor(hex, factor) {
    var r = parseInt(hex.slice(1,3), 16);
    var g = parseInt(hex.slice(3,5), 16);
    var b = parseInt(hex.slice(5,7), 16);
    r = Math.round(r + (255 - r) * factor);
    g = Math.round(g + (255 - g) * factor);
    b = Math.round(b + (255 - b) * factor);
    return 'rgb(' + r + ',' + g + ',' + b + ')';
}

// 鏇存柊鍥鹃壌杩涘害鏉?function updateAlbumProgress(allCards) {
    var container = document.getElementById('progressBars');
    var totalOwned = 0;
    var totalCards = 0;
    var allComplete = true;
    
    // 浠庢暟鎹簱鑾峰彇绋€鏈夊害鍚嶇О鍜岄鑹?    var rarityNames = [];
    var rarityColors = [];
    var maxRarity = rarityConfig.length;
    
    if (rarityConfig && rarityConfig.length > 0) {
        rarityConfig.forEach(function(cfg) {
            if (cfg.rarity >= 1 && cfg.rarity <= maxRarity) {
                rarityNames[cfg.rarity] = cfg.name;
                rarityColors[cfg.rarity] = cfg.color;
            }
        });
    }
    
    // Fallback if config not loaded yet
    if (rarityNames.length === 0) {
        rarityNames = ['', '鏅€?, '绋€鏈?, '鏉板嚭', '鍙茶瘲', '浼犺', '杩滃彜'];
        rarityColors = ['', '#ffffff', '#4caf50', '#2196f3', '#9c27b0', '#ff9800', '#f32b2b'];
    }
    
    // 鐢熸垚娣″寲鐨勮儗鏅壊
    function lightenColor(hex, factor) {
        var r = parseInt(hex.slice(1,3), 16);
        var g = parseInt(hex.slice(3,5), 16);
        var b = parseInt(hex.slice(5,7), 16);
        r = Math.round(r + (255 - r) * factor);
        g = Math.round(g + (255 - g) * factor);
        b = Math.round(b + (255 - b) * factor);
        return 'rgb(' + r + ',' + g + ',' + b + ')';
    }
    
    var html = '';
    for (var r = 1; r <= rarityConfig.length; r++) {
        var rCards = allCards.filter(function(c) { return c.rarity === r; });
        var rOwned = rCards.filter(function(c) { return myCards[c.id]; }).length;
        var rTotal = rCards.length;
        var rRate = rTotal > 0 ? (rOwned / rTotal * 100) : 0;
        
        totalOwned += rOwned;
        totalCards += rTotal;
        if (rRate < 100) allComplete = false;
        
        var isComplete = rRate >= 100;
        var rName = rarityNames[r] || '鏈煡';
        var barColor = rarityColors[r] || '#fff';
        
        var rowStyle = '';
        var nameStyle = 'width:70px;font-size:12px;color:'+barColor+';';
        var textStyle = "width:90px;font-size:12px;text-align:right;color:" + barColor + ";";
        
        if (isComplete) {
            rowStyle = 'background:rgba(255,215,0,0.15);padding:5px;border-radius:5px;';
            nameStyle = 'width:70px;font-size:12px;color:'+barColor+';font-weight:bold;';
            textStyle = 'width:90px;font-size:12px;text-align:right;color:'+barColor+';font-weight:bold;';
        }
        
        // 杩涘害鏉℃笎鍙樿儗鏅拰濉厖
        var barFillStyle = 'height:16px;border-radius:8px;transition:width 0.3s;position:relative;';
        var innerBar = '<div style="height:8px;background:'+barColor+';border-radius:4px;margin-top:4px;opacity:0.6;"></div>';
        var gradientFill = '';
        if (isComplete) {
            gradientFill = 'background:linear-gradient(180deg, '+barColor+' 0%, ' + lightenColor(barColor, 0.4) + ' 50%, '+barColor+' 100%);box-shadow:0 0 10px '+barColor+';';
        } else {
            gradientFill = 'background:linear-gradient(180deg, '+barColor+' 0%, ' + lightenColor(barColor, 0.3) + ' 100%);';
        }
        
        html += '<div style="display:flex;align-items:center;gap:10px;'+rowStyle+'">' +
            '<span style="'+nameStyle+'">' + r + ' ' + rName + '</span>' +
            '<div style="flex:1;height:20px;background:#1a1a2e;border-radius:10px;overflow:hidden;box-shadow:inset 0 2px 4px rgba(0,0,0,0.3);border:1px solid #333;">' +
                '<div style="width:'+rRate+'%;'+barFillStyle+gradientFill+'"></div>' +
            '</div>' +
            '<span style="'+textStyle+'">' + rOwned + '/' + rTotal + '</span>' +
        '</div>';
    }
    
    if (container) container.innerHTML = html;
    
    // 鏇存柊鎬昏揪鎴愮巼
    var overallRate = totalCards > 0 ? (totalOwned / totalCards * 100) : 0;
    var totalDisplay = document.getElementById('totalRateDisplay');
    if (totalDisplay) totalDisplay.textContent = overallRate.toFixed(0) + '%';
    
    if (allComplete && totalCards > 0) {
        if (totalDisplay) {
            totalDisplay.style.color = '#ffd700';
            totalDisplay.style.textShadow = '0 0 30px #ffd700, 0 0 60px #ffd700';
            totalDisplay.style.fontSize = '32px';
        }
        if (container) container.style.boxShadow = '0 0 30px rgba(255, 215, 0, 0.5), inset 0 0 20px rgba(255, 215, 0, 0.1)';
    } else {
        if (totalDisplay) {
            totalDisplay.style.color = '#4caf50';
            totalDisplay.style.textShadow = 'none';
            totalDisplay.style.fontSize = '24px';
        }
        if (container) container.style.boxShadow = 'none';
    }
    
    // 鏄剧ず/闅愯棌杩涘害鏉?    // document.getElementById('albumProgress').style.display = 'block'; // 宸插垹闄?}

function switchView(view) {
    currentView = view;
    document.getElementById('tabMyCards').classList.toggle('active', view === 'my');
    document.getElementById('tabAlbum').classList.toggle('active', view === 'album');
    // document.getElementById('myCards').classList.toggle('hidden', view !== 'my'); // 宸插垹闄?    // document.getElementById('albumGrid').classList.toggle('hidden', view !== 'album'); // 宸插垹闄?    document.getElementById('filterOwned').classList.toggle('hidden', view !== 'album');
    if (view === 'my') renderMyCards();
    else renderAlbum();
}

function applyFilter() {
    filterState.name = document.getElementById('filterName').value.trim().toLowerCase();
    filterState.rarity = document.getElementById('filterRarity').value;
    filterState.owned = document.getElementById('filterOwned').value;
    if (currentView === 'my') renderMyCards();
    else renderAlbum();
}

function resetFilter() {
    document.getElementById('filterName').value = '';
    document.getElementById('filterRarity').value = '';
    document.getElementById('filterOwned').value = '';
    filterState = { name: '', rarity: '', owned: '' };
    if (currentView === 'my') renderMyCards();
    else renderAlbum();
}

function renderAlbum() {
    var container = document.getElementById('albumGrid');
    if (!container) return;
    var allCards = allCharacters || [];
    
    
    var rarityNames = [];
    var rarityColors = [];
    
    if (rarityConfig && rarityConfig.length > 0) {
        rarityConfig.forEach(function(cfg) {
            if (cfg.rarity >= 1) {
                rarityNames[cfg.rarity] = cfg.name;
                rarityColors[cfg.rarity] = cfg.color;
            }
        });
    }
    
    // Fallback if config not loaded yet
    if (rarityNames.length === 0) {
        rarityNames = ['', '鏅€?, '绋€鏈?, '鏉板嚭', '鍙茶瘲', '浼犺', '杩滃彜'];
        rarityColors = ['', '#ffffff', '#4caf50', '#2196f3', '#9c27b0', '#ff9800', '#f32b2b'];
    }
    
    // 鐢熸垚娣″寲鐨勮儗鏅壊
    function lightenColor(hex, factor) {
        var r = parseInt(hex.slice(1,3), 16);
        var g = parseInt(hex.slice(3,5), 16);
        var b = parseInt(hex.slice(5,7), 16);
        r = Math.round(r + (255 - r) * factor);
        g = Math.round(g + (255 - g) * factor);
        b = Math.round(b + (255 - b) * factor);
        return 'rgb(' + r + ',' + g + ',' + b + ')';
    }
    
    // 閬嶅巻鎵€鏈夊崱鐗囷紝璁剧疆鑳屾櫙鑹?    allCards.forEach(function(card) {
        card._bgColor = lightenColor(rarityColors[card.rarity] || '#666', 0.85);
    });
    
    var filtered = allCards.filter(function(card) {
        var owned = userAlbum[card.id];
        if (filterState.name && !card.name.toLowerCase().includes(filterState.name)) return false;
        if (filterState.rarity && card.rarity !== parseInt(filterState.rarity)) return false;
        if (filterState.owned === 'owned' && !owned) return false;
        if (filterState.owned === 'unowned' && owned) return false;
        return true;
    });
    
    // Sort by rarity (descending)
    filtered.sort(function(a, b) { return b.rarity - a.rarity; });
    
    if (filtered.length === 0) { container.innerHTML = '<div class="empty">娌℃湁鎵惧埌鍗＄墝</div>'; return; }
    
    // 璁＄畻鍚勭█鏈夊害杈炬垚鐜囧苟鏇存柊杩涘害鏉?    updateAlbumProgress(allCards);
    
    var html = '';
    filtered.forEach(function(card) {
        var owned = userAlbum[card.id];
        var rarityName = '猸?.repeat(card.rarity);
        if (owned) {
            html += '<div class="album-card" onclick="showCardPopup('+card.id+')" style="background:'+card._bgColor+';"><div class="card-thumb" style="background:'+card._bgColor+';"><img src="'+getImageUrl(card)+'" alt="'+card.name+'"></div><h4 style="color:'+rarityColors[card.rarity]+';">'+card.name+'</h4><div class="album-stars" style="font-size:10px;color:'+rarityColors[card.rarity]+';word-break:break-all;">'+rarityName+'</div><span class="count">x'+owned.count+'</span></div>';
        } else {
            html += '<div class="album-card locked"><div class="card-thumb" style="background:inherit;"><img src="'+getImageUrl(card)+'" alt="'+card.name+'" style="filter:grayscale(100%) brightness(0.7);"></div><h4 style="color:'+rarityColors[card.rarity]+';">'+card.name+'</h4><div class="album-stars" style="font-size:10px;color:'+rarityColors[card.rarity]+';word-break:break-all;filter:grayscale(50%);">'+rarityName+'</div><span class="count">鏈嫢鏈?/span></div>';
        }
    });
    container.innerHTML = html;
}

function showCardPopup(id) {
var card = myCards[id];
if (!card) return;
var rarityColor = getRarityColor(card.rarity);
var rarityName = '猸?.repeat(card.rarity);
document.getElementById('popupImage').src = getImageUrl(card);
document.getElementById('popupName').textContent = card.name;
document.getElementById('popupName').style.color = rarityColor;
document.getElementById('popupRarity').innerHTML = '<span style="color:'+rarityColor+'">' + rarityName + '</span>';
document.getElementById('popupDesc').textContent = card.description || '';
document.getElementById('popupStatsBox').innerHTML = 
    '<div class="stat-row"><span class="stat-label">HP</span><span class="stat-value" style="color:'+getStatColor((card.baseStats || {}).HP, 'HP')+'">'+(card.baseStats || {}).HP+'</span></div>' +
    '<div class="stat-row"><span class="stat-label">ATK</span><span class="stat-value" style="color:'+getStatColor((card.baseStats || {}).ATK, 'ATK')+'">'+(card.baseStats || {}).ATK+'</span></div>' +
    '<div class="stat-row"><span class="stat-label">DEF</span><span class="stat-value" style="color:'+getStatColor((card.baseStats || {}).DEF, 'DEF')+'">'+(card.baseStats || {}).DEF+'</span></div>' +
    '<div class="stat-row"><span class="stat-label">SKL</span><span class="stat-value" style="color:'+getStatColor((card.baseStats || {}).SKL, 'SKL')+'">'+(card.baseStats || {}).SKL+'</span></div>' +
    '<div class="stat-row"><span class="stat-label">SPD</span><span class="stat-value" style="color:'+getStatColor((card.baseStats || {}).SPD, 'SPD')+'">'+(card.baseStats || {}).SPD+'</span></div>';
document.getElementById('popupCount').textContent = '鎸佹湁: ' + card.count + ' 寮?;
            
            // document.getElementById('cardPopup').classList.add('show'); // 宸插垹闄?setTimeout(function() { drawRadar(card); }, 100);
}

