function drawRadar(card) {
var canvas = document.getElementById('radarCanvas');
var ctx = canvas.getContext('2d');
var w = canvas.width = canvas.offsetWidth;
var h = canvas.height = canvas.offsetHeight;
var cx = w / 2;
var cy = h / 2;
var r = Math.min(w, h) / 2 - 30;
var labels = ['HP', 'MP', '鏀诲嚮', '闃插尽', '鏁忔嵎'];
var stats = [
Math.round((card.baseStats || card.base_stats || {}).HP / maxStats.HP * 100),
Math.round((card.baseStats || card.base_stats || {}).SKL / maxStats.SKL * 100),
Math.round((card.baseStats || card.base_stats || {}).ATK / maxStats.ATK * 100),
Math.round((card.baseStats || card.base_stats || {}).DEF / maxStats.DEF * 100),
Math.round((card.baseStats || card.base_stats || {}).SKL / maxStats.SKL * 100)
];
var maxVal = 100;
var angleStep = (Math.PI * 2) / 5;
ctx.clearRect(0, 0, w, h);
// 鐢昏儗鏅渾
for (var i = 1; i <= 5; i++) {
ctx.beginPath();
ctx.arc(cx, cy, r * i / 5, 0, Math.PI * 2);
ctx.strokeStyle = '#333';
ctx.stroke();
}
// 鐢昏酱绾?for (var i = 0; i < 5; i++) {
ctx.beginPath();
ctx.moveTo(cx, cy);
ctx.lineTo(cx + Math.cos(i * angleStep - Math.PI/2) * r, cy + Math.sin(i * angleStep - Math.PI/2) * r);
ctx.strokeStyle = '#333';
ctx.stroke();
ctx.fillStyle = '#aaa';
ctx.font = '12px Arial';
ctx.textAlign = 'center';
ctx.fillText(labels[i], cx + Math.cos(i * angleStep - Math.PI/2) * (r + 20), cy + Math.sin(i * angleStep - Math.PI/2) * (r + 20));
}
// 鐢绘暟鎹尯鍩?ctx.beginPath();
for (var i = 0; i < 5; i++) {
var x = cx + Math.cos(i * angleStep - Math.PI/2) * (r * stats[i] / maxVal);
var y = cy + Math.sin(i * angleStep - Math.PI/2) * (r * stats[i] / maxVal);
if (i === 0) ctx.moveTo(x, y);
else ctx.lineTo(x, y);
}
ctx.closePath();
ctx.fillStyle = 'rgba(233, 69, 96, 0.3)';
ctx.fill();
ctx.strokeStyle = '#e94560';
ctx.lineWidth = 2;
ctx.stroke();
// 鐢绘暟鎹偣
for (var i = 0; i < 5; i++) {
var x = cx + Math.cos(i * angleStep - Math.PI/2) * (r * stats[i] / maxVal);
var y = cy + Math.sin(i * angleStep - Math.PI/2) * (r * stats[i] / maxVal);
ctx.beginPath();
ctx.arc(x, y, 5, 0, Math.PI * 2);
ctx.fillStyle = '#e94560';
ctx.fill();
}
}

var maxStats = {HP:0, ATK:0, DEF:0, SKL:0, SPD:0};
var minStats = {hp:Infinity, mp:Infinity, attack:Infinity, defense:Infinity, agility:Infinity};

function calcMaxStats() {
if (!gameData || !gameData.characters) return;
gameData.characters.forEach(function(c) {
    var stats = c.baseStats || c.base_stats || {};
    if (stats.HP > maxStats.HP) maxStats.HP = stats.HP;
    if (stats.HP < minStats.HP) minStats.HP = stats.HP;
    if (stats.SKL > maxStats.SKL) maxStats.SKL = stats.SKL;
    if (stats.SKL < minStats.SKL) minStats.SKL = stats.SKL;
    if (stats.ATK > maxStats.ATK) maxStats.ATK = stats.ATK;
    if (stats.ATK < minStats.ATK) minStats.ATK = stats.ATK;
    if (stats.DEF > maxStats.DEF) maxStats.DEF = stats.DEF;
    if (stats.DEF < minStats.DEF) minStats.DEF = stats.DEF;
    if (stats.SKL > maxStats.SKL) maxStats.SKL = stats.SKL;
    if (stats.SKL < minStats.SKL) minStats.SKL = stats.SKL;
});
if (minStats.HP === Infinity) minStats.HP = 0;
if (minStats.SKL === Infinity) minStats.SKL = 0;
if (minStats.ATK === Infinity) minStats.ATK = 0;
if (minStats.DEF === Infinity) minStats.DEF = 0;
if (minStats.SKL === Infinity) minStats.SKL = 0;
}

function updateCostDisplay() {
    var cost = drawCost;
    var cost10 = Math.floor(cost * 10 * 0.9);
    document.getElementById('drawCost').textContent = cost;
    document.getElementById('drawCost10').textContent = cost10;
}

// 褰撳墠閫変腑鐨勯厤缃甀D
var currentConfigId = 5;

// 鍔犺浇閰嶇疆鍒楄〃
function loadConfigList() {
    fetch('game_api.php?action=get_draw_configs').then(r => r.json()).then(d => {
        console.log('閰嶇疆鏁版嵁:', d);
        if (d.code === 200 && d.configs) {
            const select = document.getElementById('configSelect');
            select.innerHTML = '';
            d.configs.forEach(function(cfg) {
                const option = document.createElement('option');
                option.value = cfg.id;
                option.textContent = cfg.config_name + ' (娑堣€? + cfg.draw_cost + ' ' + cfg.currency_name + ')';
                select.appendChild(option);
            });
            // 榛樿閫変腑绗竴涓?            if (d.configs.length > 0) {
                select.value = currentConfigId;
            }
        }
    }).catch(e => console.error('鍔犺浇閰嶇疆鍒楄〃澶辫触:', e));
}

// 鍒囨崲閰嶇疆
function changeConfig(configId) {
    configId = parseInt(configId);
    if (!configId) return;
    
    console.log('鍒囨崲閰嶇疆:', configId);
    currentConfigId = configId;
    localStorage.setItem('drawConfigId', configId);
    
    // 鍏堟竻绌烘暟鎹己鍒堕噸鏂拌幏鍙?    myGold = 0;
    document.getElementById('userBalance').textContent = '鍔犺浇涓?..';
    
    // 閲嶆柊鍔犺浇鏁版嵁
    loadConfigList();
    loadData();
}

function loadData() {
    // 鑾峰彇鐢ㄦ埛ID
    userId = localStorage.getItem('user_id') || localStorage.getItem('userId');
    if (!userId) {
        window.location.href = 'login.html';
        return;
    }
    
    // 鑾峰彇鐢ㄦ埛璐у竵鍜屾娊鍗￠厤缃紙甯onfig_id鍙傛暟锛?    Promise.all([
        fetch('game_api.php?action=get_user_currency&user_id=' + userId + '&config_id=' + currentConfigId).then(r => r.json()),
        fetch('game_api.php?action=get_config&config_id=' + currentConfigId).then(r => r.json())
    ]).then(([userData, configData]) => {
        // 璁剧疆鐢ㄦ埛璐у竵
        if (userData.code === 200) {
            myGold = userData.gold || 0;
            console.log('璐у竵鏁版嵁:', userData);
        }
        
        // 璁剧疆璐у竵鍚嶇О鍜屾秷鑰楋紙鍏ㄥ眬鍙橀噺锛?        currencyName = '鍏冨疂';
        drawCost = 100;
        if (configData.code === 200 && configData.config) {
            currencyName = configData.config.currency_name || '鍏冨疂';
            drawCost = configData.config.draw_cost || 100;
            currencyId = configData.config.currency_id || 1;
            // 璁剧疆drawConfig渚涙鐜囬瑙堜娇鐢?            drawConfig = {
                rarity_weight: configData.config.rarity_weight || [],
                tag: configData.config.tag || [],
                tag_weight: configData.config.tag_weight || [],
                card_pool: configData.config.card_pool || []
            };
        }
        
        // 鏇存柊鏄剧ず
        try {
            var el = document.getElementById('userBalance');
            if (el) {
                el.textContent = '鎴戠殑' + currencyName + ': ' + myGold;
                console.log('浣欓鏇存柊:', '鎴戠殑' + currencyName + ': ' + myGold);
            } else {
                console.log('userBalance鍏冪礌鏈壘鍒?);
            }
            var goldAmountEl = document.getElementById('goldAmount');
            var goldUnitEl = document.getElementById('goldUnit');
            if (goldAmountEl) goldAmountEl.textContent = myGold;
            if (goldUnitEl) goldUnitEl.textContent = currencyName;
        } catch(e) {
            console.error('鏇存柊浣欓澶辫触:', e);
        }
        document.querySelectorAll('#currencyUnit').forEach(function(el) { el.textContent = currencyName; });
        document.getElementById('drawCost').textContent = drawCost;
        document.getElementById('drawCost10').textContent = Math.floor(drawCost * 10 * 0.9);
        
        // 鏇存柊鎶藉崱娑堣€楁枃瀛?        var costText = '娑堣€?' + drawCost + ' ' + currencyName;
        var cost10Text = '娑堣€?' + Math.floor(drawCost * 10 * 0.9) + ' ' + currencyName + ' (9鎶?';
    }).catch(e => console.error('鍔犺浇澶辫触:', e));
    // 鍔犺浇绋€鏈夊害閰嶇疆 - 浠庢暟鎹簱璇诲彇
    fetch('game_api.php?action=get_rarity').then(function(res) { return res.json(); }).then(function(data) {
        rarityConfig = data.rarity || [];
        populateRarityFilter();
    }).catch(function(e) {
        console.error('鍔犺浇绋€鏈夊害閰嶇疆澶辫触:', e);
        rarityConfig = [];
    });
    
    // 鍏堣幏鍙栧浘閴存暟鎹紝鐒跺悗鍔犺浇鍗＄墝鏁版嵁锛屼竴璧峰畬鎴愬悗娓叉煋
    Promise.all([
        fetch('game_api.php?action=get_user_album&user_id=' + userId).then(r => r.json()),
        fetch('game_api.php?action=get_all&user_id=' + userId).then(r => r.json())
    ]).then(function(results) {
        var albumData = results[0];
        var cardsData = results[1];
        
        if (albumData.code === 200 && albumData.album) {
            userAlbum = albumData.album;
        }
        
        if (cardsData.code === 200) {
            gameData = cardsData;
            allCharacters = cardsData.characters || [];
            calcMaxStats();
        }
        
        renderMyCards();
        renderAlbum();
    }).catch(function(e) { 
        console.error(e); 
    });
}
loadConfigList();
    loadData();

async function showResult10(cards) {
var container = document.getElementById('resultCard10');
console.log('showResult10 cards:', cards);
var rarityColors = getRarityColorsFromConfig();
var rarityNames = getRarityNamesFromConfig();
console.log(' rarityColors:', rarityColors, ' rarityNames:', rarityNames);

function getRarityColorsFromConfig() {
    if (rarityConfig && rarityConfig.length > 0) {
        var colors = [''];
        rarityConfig.forEach(function(cfg) {
            colors[cfg.rarity] = cfg.color;
        });
        return colors;
    }
    return ['', '#ffffff', '#4caf50', '#2196f3', '#9c27b0', '#ff9800', '#f32b2b'];
}

function getRarityNamesFromConfig() {
    if (rarityConfig && rarityConfig.length > 0) {
        var names = [''];
        rarityConfig.forEach(function(cfg) {
            names[cfg.rarity] = cfg.name;
        });
        return names;
    }
    return ['', '鏅€?, '绋€鏈?, '鏉板嚭', '鍙茶瘲', '浼犺', '杩滃彜'];
}

// Before updating, record which cards are newly obtained
var wasNewBefore = {};
cards.forEach(function(card) {
if (!ownedCardIds[card.id] && !wasNewBefore[card.id]) {
wasNewBefore[card.id] = true;
}
});

// Update counts and save to DB - 鍚屾绛夊緟淇濆瓨瀹屾垚
for (var ci = 0; ci < cards.length; ci++) {
    var card = cards[ci];
    if (!myCards[card.id]) myCards[card.id] = JSON.parse(JSON.stringify(card));
    myCards[card.id].count = (myCards[card.id].count || 0) + 1;
    if (userId && card.id) {
        console.log('淇濆瓨鍗＄墝: userId=' + userId + ', card_id=' + card.id + ', config_id=' + currentConfigId);
        await fetch('game_api.php?action=add_user_card&user_id=' + userId + '&card_id=' + card.id + '&config_id=' + currentConfigId + '&draw_count=1', {method: 'POST'});
    }
}

// Display: only first occurrence of each new card shows "鏂帮紒"
var firstSeen = {};
var html = '<h3>馃帀 鍗佽繛鎶界粨鏋?/h3><div class="grid-10">';
// 2-3-3-2 layout
var layout = [2, 3, 3, 2];
var idx = 0;
layout.forEach(function(count, rowIdx) {
  html += '<div class="grid-row">';
  for (var i = 0; i < count && idx < cards.length; i++) {
    var card = cards[idx++];
    var showNew = false;
    if (wasNewBefore[card.id] && !firstSeen[card.id]) {
      showNew = true;
      firstSeen[card.id] = true;
    }
    var newTag = showNew ? '<span class="new-tag">鏂帮紒</span>' : '';
    var rname = rarityNames[card.rarity] || '';
    var stars = '猸?.repeat(card.rarity);
    html += '<div class="card-item rarity-'+card.rarity+'"><div class="thumb"><img src="'+getImageUrl(card)+'" alt="'+card.name+'"></div><h4 class="card-name-'+card.rarity+'">'+card.name+'</h4><div class="stars" style="color:'+rarityColors[card.rarity]+';text-align:center;">'+stars+'</div><div style="color:'+rarityColors[card.rarity]+';text-align:center;font-size:10px;">'+rname+'</div>'+newTag+'</div>';
  }
  html += '</div>';
});
html += '</div>';
container.innerHTML = html;
container.classList.add('show');
renderMyCards();
}
</script>
